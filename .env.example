# SentFund environment template. Copy to .env (git-ignored) and fill in locally.
# Placeholders only. Never put real keys in this file or in any committed file.
# Private keys live in ~/.near-credentials (managed by near-cli) or in .env on the server only.

# ---- App ----
NODE_ENV=development
# Bind to localhost only on the shared server.
HOST=127.0.0.1
PORT=8092
APP_BASE_URL=http://127.0.0.1:8092
# Enables seeded demo logins (maker/app1/app2/admin@sentfund.my.id). Never enable on a real deployment.
DEMO_MODE=true
# 32+ random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-random-secret
LOG_LEVEL=info

# ---- Database ----
# SQLite file on a persistent disk (see docs/DECISIONS.md D-023).
DATABASE_URL=file:./data/sentfund.sqlite

# ---- NEAR (testnet only; the app refuses any other value) ----
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/

# Public contract/account IDs (the deployed testnet accounts; see docs/TESTNET.md)
TUSDC_CONTRACT_ID=tusdc.sentfund-payroll.testnet
VAULT_CONTRACT_ID=vault.sentfund-payroll.testnet
MAKER_ACCOUNT_ID=maker.sentfund-payroll.testnet
APPROVER1_ACCOUNT_ID=approver1.sentfund-payroll.testnet
APPROVER2_ACCOUNT_ID=approver2.sentfund-payroll.testnet
WORKER_ACCOUNT_ID=worker.sentfund-payroll.testnet
ADMIN_SIGNER_ACCOUNT_ID=admin.sentfund-payroll.testnet

# Restricted signer keys (function-call access keys scoped to the vault contract).
# Format: the near-cli ed25519 secret-key string. Leave empty here; set only in the server's private .env.
MAKER_SIGNER_PRIVATE_KEY=
APPROVER1_SIGNER_PRIVATE_KEY=
APPROVER2_SIGNER_PRIVATE_KEY=
WORKER_SIGNER_PRIVATE_KEY=
ADMIN_SIGNER_PRIVATE_KEY=

# ---- Demo caps (base units, 6 decimals; see docs/DECISIONS.md D-027) ----
TUSDC_DECIMALS=6
DEMO_CAP_PER_ROW_BASE_UNITS=1000000
DEMO_CAP_PER_RUN_BASE_UNITS=100000000

# ---- Payroll assistant (Phase 19, optional) ----
# Anthropic Claude API key for the maker's payroll assistant. Leave empty: the assistant is then
# off ("no API key") and everything else works. Set it only in your private .env; never commit it.
ANTHROPIC_API_KEY=
# Claude model ID. Empty = claude-opus-5-5 (Anthropic's documented default model).
ASSISTANT_MODEL=
