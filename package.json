{
  "name": "gajian",
  "version": "0.1.0",
  "private": true,
  "description": "GAJIAN: payroll batches with contract-enforced approvals and NEAR testnet wallet payouts",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "./scripts/with-tmp.sh next dev -H 127.0.0.1 -p 8092",
    "build": "./scripts/with-tmp.sh next build",
    "start": "./scripts/with-tmp.sh next start -H 127.0.0.1 -p 8092",
    "lint": "./scripts/with-tmp.sh eslint .",
    "typecheck": "./scripts/with-tmp.sh tsc --noEmit",
    "test": "./scripts/with-tmp.sh vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "samples:check": "./scripts/with-tmp.sh node scripts/generate-sample-payroll.mjs && git diff --exit-code -- public/templates docs/SAMPLE-DATA.md",
    "contracts:build": "./scripts/with-tmp.sh -C contracts sh ../scripts/build-contracts.sh",
    "contracts:test": "./scripts/with-tmp.sh -C contracts cargo test --workspace --locked",
    "contracts:lint": "./scripts/with-tmp.sh -C contracts sh -c 'cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings'",
    "clean:tmp": "rm -rf .tmp && mkdir .tmp",
    "db:migrate": "./scripts/with-tmp.sh node --env-file-if-exists=.env scripts/db.ts migrate",
    "db:seed": "./scripts/with-tmp.sh node --env-file-if-exists=.env scripts/db.ts seed",
    "db:status": "./scripts/with-tmp.sh node --env-file-if-exists=.env scripts/db.ts status",
    "db:generate": "./scripts/with-tmp.sh drizzle-kit generate",
    "test:e2e": "./scripts/with-tmp.sh playwright test",
    "screenshots": "./scripts/with-tmp.sh playwright test tests/e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": false
  }
}
